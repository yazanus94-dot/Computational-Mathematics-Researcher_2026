# Randomized low-rank approximation with power iterations               //Readme
Implements the Halko–Martinsson–Tropp randomized range finder / SVD and validates it numerically.
**Checks:** exact recovery of low-rank matrices; empirical E||A−QQᵀA||_F against the theoretical bound;
monotone spectral-error reduction with power iterations q=0,1,2; singular-value accuracy.
Run: `pip install numpy pytest && pytest`


"""Randomized low-rank approximation (Halko-Martinsson-Tropp) with power iterations."""      // rsvd
import numpy as np


def make_matrix(m, n, decay=0.5, rng=None):
    """Matrix with known singular values sigma_j = (j+1)^(-decay*4)... exponential-free polynomial decay."""
    rng = np.random.default_rng(rng)
    r = min(m, n)
    U, _ = np.linalg.qr(rng.standard_normal((m, r)))
    V, _ = np.linalg.qr(rng.standard_normal((n, r)))
    s = (np.arange(1, r + 1)) ** (-decay * 4.0)
    return (U * s) @ V.T, s


def range_finder(A, k, p=10, q=0, rng=None):
    """Orthonormal Q (m x (k+p)) approximating range(A); q power iterations with re-orthonormalisation."""
    rng = np.random.default_rng(rng)
    Omega = rng.standard_normal((A.shape[1], k + p))
    Q, _ = np.linalg.qr(A @ Omega)
    for _ in range(q):
        W, _ = np.linalg.qr(A.T @ Q)
        Q, _ = np.linalg.qr(A @ W)
    return Q


def rsvd(A, k, p=10, q=0, rng=None):
    """Return U, s, Vt of rank k."""
    Q = range_finder(A, k, p, q, rng)
    B = Q.T @ A
    Ub, s, Vt = np.linalg.svd(B, full_matrices=False)
    return (Q @ Ub)[:, :k], s[:k], Vt[:k]


def frob_bound(s, k, p):
    """Halko et al. Thm 10.5 expectation bound for E||A - QQ^T A||_F (q=0)."""
    return np.sqrt(1 + k / (p - 1)) * np.sqrt(np.sum(s[k:] ** 2))


def spectral_error(A, Q):
    return np.linalg.norm(A - Q @ (Q.T @ A), 2);


import numpy as np                                                  // test_rsvd.py
from rsvd import *

def test_exact_low_rank_recovered():
    rng = np.random.default_rng(0)
    A = rng.standard_normal((200, 8)) @ rng.standard_normal((8, 150))
    U, s, Vt = rsvd(A, 8, p=5, rng=1)
    assert np.linalg.norm(A - (U * s) @ Vt) / np.linalg.norm(A) < 1e-10

def test_expected_frobenius_bound_holds():
    A, s = make_matrix(300, 200, 0.3, rng=0)
    k, p = 10, 8
    errs = [np.linalg.norm(A - (lambda Q: Q @ (Q.T @ A))(range_finder(A, k, p, 0, rng=t)), 'fro')
            for t in range(40)]
    assert np.mean(errs) <= frob_bound(s, k, p)

def test_power_iterations_reduce_spectral_error():
    A, s = make_matrix(400, 300, 0.2, rng=2)
    k = 10
    e = [np.mean([spectral_error(A, range_finder(A, k, 5, q, rng=t)) for t in range(10)]) for q in (0, 1, 2)]
    assert e[0] > e[1] > e[2]
    assert e[2] < 1.5 * s[k]          # near-optimal (Eckart-Young: s[k] for rank k+... )

def test_singular_values_accuracy():
    A, s = make_matrix(300, 300, 0.5, rng=3)
    _, sr, _ = rsvd(A, 5, p=10, q=2, rng=4)
    assert np.allclose(sr, s[:5], rtol=1e-6)



